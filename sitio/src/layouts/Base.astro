---
import '../styles/global.css';
import { obtenerConfiguracion, obtenerMenu } from '../lib/api';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import RedesSociales from '../components/RedesSociales.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
    titulo: string;
    descripcion?: string;
    imagen?: string;
    /** Objeto schema.org que se inyecta como JSON-LD en esta página. */
    datos?: Record<string, unknown>;
}

const { titulo, descripcion, imagen, datos } = Astro.props;

// Nada de esto está escrito en la plantilla a propósito: el nombre, el menú y
// los datos de contacto se editan desde el panel. Si estuvieran aquí, cambiar
// el correo del CERSEU exigiría tocar código y desplegar — y montar el sitio
// para otra unidad exigiría un fork, que es justo lo que este proyecto vino a
// dejar de hacer.
const sitio = await obtenerConfiguracion();
const menu = await obtenerMenu();

const contacto = sitio.contacto;

const resumen = descripcion ?? sitio.descripcion ?? "";
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenSocial = imagen ?? sitio.portada.imagenes[0] ?? undefined;

// Ficha de la organización para buscadores. Sale de Configuración como todo
// lo demás: si cambia el correo en el panel, cambia aquí también.
const organizacion = {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    name: sitio.nombre,
    description: sitio.descripcion,
    url: Astro.site?.href,
    email: contacto.email,
    telephone: contacto.telefono,
    address: contacto.direccion,
    sameAs: Object.values(sitio.redes),
};
const telefono = [contacto.telefono, contacto.anexo && `Anexo ${contacto.anexo}`]
    .filter(Boolean)
    .join(' · ');
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{titulo} · {sitio.nombre}</title>
        <meta name="description" content={resumen} />
        <link rel="canonical" href={canonica} />

        {/* Transiciones entre páginas con la API nativa del navegador: se
            sustituye el documento sin recargar, así el encabezado no parpadea
            al navegar. Donde el navegador no la soporta, navega como siempre;
            no hay nada que degradar. Respeta prefers-reduced-motion. */}
        <ClientRouter />

        {/* Open Graph: lo que se ve al compartir el enlace. Sin esto, un
            enlace pegado en WhatsApp sale como texto pelado. */}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={sitio.nombre ?? ""} />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={resumen} />
        <meta property="og:url" content={canonica} />
        {imagenSocial && <meta property="og:image" content={imagenSocial} />}
        <meta name="twitter:card" content={imagenSocial ? "summary_large_image" : "summary"} />

        {/* Datos estructurados. Siempre la organizacion; las paginas que lo
            necesiten anaden el suyo por `datos`. */}
        <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />
        {datos && <script type="application/ld+json" set:html={JSON.stringify(datos)} />}
    </head>
    <body class="flex min-h-screen flex-col bg-white text-slate-800 antialiased">
        {/* Primer tabulador de la página: permite saltarse el menú entero, que
            son 20 enlaces antes de llegar al contenido. */}
        <a href="#contenido" class="saltar-al-contenido rounded-lg bg-unmsm-azul px-4 py-2 font-semibold text-white">
            Saltar al contenido
        </a>
        <header class="bg-unmsm-azul text-white">
            <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
                <a href="/" class="leading-tight">
                    <span class="block text-[0.6rem] uppercase tracking-[0.18em] text-unmsm-azul-soft">
                        Centro de Responsabilidad Social y Extensión Universitaria
                    </span>
                    <span class="block text-2xl font-bold tracking-tight">{sitio.nombre}</span>
                </a>

                {/* Un solo <details> envuelve la navegacion en movil: cerrado por
                   defecto, abierto siempre desde `sm`. Mismo marcado para las dos
                   anchuras, sin duplicar el menu ni necesitar JavaScript. */}
                {/* Abierto por defecto y cerrado por el script de abajo solo si la
                   pantalla es estrecha. Al reves —cerrado y forzado a abrirse con
                   CSS en escritorio— dependeria de anular el ocultado interno que
                   hace el navegador, que cambia entre motores y que aqui no pude
                   verificar en un viewport movil real. Sin JavaScript el menu
                   queda desplegado: peor de aspecto, nunca inaccesible. */}
                <details class="nav-plegable w-full sm:w-auto" open>
                    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1 text-sm font-medium sm:hidden [&::-webkit-details-marker]:hidden">
                        <span aria-hidden="true" class="text-lg leading-none">☰</span>
                        Menú
                    </summary>

                <nav class="flex flex-col gap-y-2 pt-3 text-sm font-medium sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:pt-0" aria-label="Principal">
                    {
                        menu.map((item) =>
                            item.hijos.length > 0 ? (
                                /* <details> en vez de :hover: funciona con teclado, con lector
                                   de pantalla y con el dedo, y no necesita JavaScript. Un menu
                                   que solo abre al pasar el raton deja fuera a quien navega
                                   con tabulador y a cualquiera en un movil. */
                                <details class="group relative">
                                    <summary class="cursor-pointer list-none hover:text-unmsm-dorado-light [&::-webkit-details-marker]:hidden">
                                        {item.etiqueta}
                                        <span aria-hidden="true" class="ml-1 inline-block transition group-open:rotate-180">
                                            ▾
                                        </span>
                                    </summary>
                                    <ul class="absolute left-0 top-full z-10 mt-1 min-w-56 rounded-lg bg-white py-2 text-slate-700 shadow-xl">
                                        {item.hijos.map((hijo) => (
                                            <li>
                                                <a
                                                    href={hijo.enlace ?? "#"}
                                                    target={hijo.nueva_pestana ? "_blank" : undefined}
                                                    rel={hijo.nueva_pestana ? "noopener noreferrer" : undefined}
                                                    class="block px-4 py-2 text-sm hover:bg-slate-50 hover:text-unmsm-azul"
                                                >
                                                    {hijo.etiqueta}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </details>
                            ) : (
                                <a
                                    href={item.enlace ?? "#"}
                                    target={item.nueva_pestana ? "_blank" : undefined}
                                    rel={item.nueva_pestana ? "noopener noreferrer" : undefined}
                                    class="hover:text-unmsm-dorado-light"
                                >
                                    {item.etiqueta}
                                </a>
                            )
                        )
                    }
                </nav>
                </details>
            </div>
        </header>

        <script is:inline>
            // Colapsa el menu en pantallas estrechas. Va inline y sin `defer`
            // para que ocurra antes del primer pintado y no se vea abrirse y
            // cerrarse.
            (function () {
                var estrecha = window.matchMedia("(max-width: 39.99rem)");
                var menu = document.querySelector(".nav-plegable");
                if (!menu) return;
                function ajustar(e) { menu.open = !e.matches; }
                ajustar(estrecha);
                estrecha.addEventListener("change", ajustar);
            })();
        </script>

        <main id="contenido" class="flex-1">
            <slot />
        </main>

        {contacto.whatsapp && (
            <BotonWhatsapp url={contacto.whatsapp} telefono={contacto.telefono} />
        )}

        <footer class="bg-unmsm-azul-dark text-sm text-slate-300">
            <div class="mx-auto max-w-6xl px-6 py-14">
                <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
                    <div class="lg:col-span-2">
                        <p class="font-serif text-lg font-bold text-white">{sitio.nombre}</p>
                        {sitio.descripcion && (
                            <p class="mt-3 max-w-md leading-relaxed">{sitio.descripcion}</p>
                        )}

                        <div class="mt-6">
                            <RedesSociales redes={sitio.redes} />
                        </div>
                    </div>

                    <div>
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-white">Contacto</h2>
                        <ul class="mt-4 space-y-2">
                            {contacto.direccion && <li>{contacto.direccion}</li>}
                            {contacto.email && (
                                <li>
                                    <a href={`mailto:${contacto.email}`} class="hover:text-white">
                                        {contacto.email}
                                    </a>
                                </li>
                            )}
                            {telefono && (
                                <li>
                                    {contacto.whatsapp ? (
                                        <a href={contacto.whatsapp} class="hover:text-white">{telefono}</a>
                                    ) : (
                                        telefono
                                    )}
                                </li>
                            )}
                            {contacto.horario && <li class="text-slate-400">{contacto.horario}</li>}
                        </ul>
                    </div>

                    <div>
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-white">Enlaces</h2>
                        <ul class="mt-4 space-y-2">
                            {menu
                                .filter((i) => i.enlace && !i.nueva_pestana)
                                .slice(0, 6)
                                .map((i) => (
                                    <li>
                                        <a href={i.enlace!} class="hover:text-white">{i.etiqueta}</a>
                                    </li>
                                ))}
                        </ul>
                    </div>
                </div>

                <p class="mt-12 border-t border-white/10 pt-6 text-xs text-slate-400">
                    Prueba de concepto del sitio público en Astro, generado contra la API de
                    contenido de Laravel. El sitio en producción sigue siendo el de Blade.
                </p>
            </div>
        </footer>
    </body>
</html>
