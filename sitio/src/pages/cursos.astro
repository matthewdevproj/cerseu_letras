---
import Base from '../layouts/Base.astro';
import { obtenerProgramas } from '../lib/api';

const cursos = await obtenerProgramas('cursos');
---

<Base titulo="Cursos" descripcion="Oferta completa de cursos del CERSEU de la Facultad de Letras UNMSM.">
    <section class="mx-auto max-w-6xl px-6 py-14">
        <h1 class="text-3xl font-bold text-unmsm-azul">Nuestros Cursos</h1>
        <p class="mt-2 text-slate-600">
            {cursos.length} {cursos.length === 1 ? 'curso' : 'cursos'} en la oferta del CERSEU.
        </p>

        {
            cursos.length === 0 ? (
                <p class="mt-16 text-center text-slate-500">
                    Por el momento no hay cursos disponibles.
                </p>
            ) : (
                <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {cursos.map((curso) => (
                        <article class="flex flex-col rounded-xl border border-slate-200 p-6 shadow-sm transition hover:shadow-md">
                            <div class="flex flex-wrap gap-2">
                                {curso.medidas.map((medida) => (
                                    <span class="rounded-full bg-unmsm-dorado/15 px-3 py-1 text-xs font-medium text-unmsm-azul-dark">
                                        {medida}
                                    </span>
                                ))}
                                {curso.modalidad && (
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                                        {curso.modalidad}
                                    </span>
                                )}
                            </div>

                            <h2 class="mt-4 text-lg font-bold leading-snug text-unmsm-azul">
                                {curso.nombre}
                            </h2>

                            {curso.sumilla && (
                                <p class="mt-3 line-clamp-3 text-sm text-slate-600">{curso.sumilla}</p>
                            )}

                            <a
                                href={curso.url}
                                class="mt-auto pt-5 text-sm font-semibold text-unmsm-azul hover:underline"
                            >
                                Más información →
                            </a>
                        </article>
                    ))}
                </div>
            )
        }
    </section>
</Base>
