---
import Base from '../layouts/Base.astro';
import { obtenerTipos, obtenerConfiguracion, obtenerDocentes, obtenerProgramas } from '../lib/api';
import TituloSeccion from '../components/TituloSeccion.astro';
import BandaIndicadores from '../components/BandaIndicadores.astro';
import PasosInscripcion from '../components/PasosInscripcion.astro';
import OfertaDestacada from '../components/OfertaDestacada.astro';

// Se resuelve en el build: el HTML sale ya con estos datos dentro y el
// visitante no espera a ninguna petición.
const tipos = await obtenerTipos();

// El hero se edita en Configuración, no aquí. Tener el titular en la
// plantilla obligaría a desplegar para cambiar una palabra.
const sitio = await obtenerConfiguracion();
const { portada, inscripcion } = sitio;
const docentes = await obtenerDocentes();
const programas = await obtenerProgramas();
const fondo = portada.imagenes[0];
---

<Base
    titulo="Inicio"
    descripcion="Formación abierta a toda la comunidad: talleres, cursos y especializaciones del CERSEU de la Facultad de Letras."
>
    <section class="relative isolate overflow-hidden text-white">
        {
            fondo && (
                <img
                    src={fondo}
                    alt=""
                    fetchpriority="high"
                    decoding="async"
                    class="absolute inset-0 -z-10 h-full w-full object-cover"
                />
            )
        }
        {/* Velo sobre la foto: sin el, el texto blanco pierde contraste sobre las
            zonas claras del campus y deja de cumplir AA. */}
        <div class="absolute inset-0 -z-10 bg-linear-to-r from-unmsm-azul-dark/95 via-unmsm-azul/85 to-unmsm-azul/60"></div>

        <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
            {portada.kicker && (
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                    {portada.kicker}
                </p>
            )}

            {portada.titulo && (
                <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight sm:text-5xl">
                    {portada.titulo}
                </h1>
            )}

            {portada.texto && (
                <p class="mt-5 max-w-2xl text-lg text-slate-100">{portada.texto}</p>
            )}

            {portada.acciones.length > 0 && (
                <div class="mt-8 flex flex-wrap gap-4">
                    {portada.acciones.map((accion, i) => (
                        <a
                            href={accion.url}
                            class={
                                i === 0
                                    ? "rounded-lg bg-unmsm-dorado px-6 py-3 font-semibold text-unmsm-azul-dark transition hover:bg-unmsm-dorado-light"
                                    : "rounded-lg border border-white/40 px-6 py-3 font-semibold transition hover:bg-white/10"
                            }
                        >
                            {accion.texto}
                        </a>
                    ))}
                </div>
            )}
        </div>
    </section>

    <BandaIndicadores tipos={tipos} docentes={docentes.length} />

    <section class="mx-auto max-w-6xl px-6 py-20">
        <TituloSeccion
            titulo="Nuestra oferta"
            kicker="Formación abierta"
            bajada="Cada tipo se mide con la unidad que le es propia."
            centrado
        />

        <div class="mt-12 grid gap-6 sm:grid-cols-3">
            {
                tipos.map((tipo) => (
                    <a
                        href={`/${tipo.slug}`}
                        class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-unmsm-azul/30 hover:shadow-xl"
                    >
                        <span
                            aria-hidden="true"
                            class="absolute inset-x-0 top-0 h-1 bg-unmsm-dorado opacity-0 transition group-hover:opacity-100"
                        />
                        <h3 class="font-serif text-xl font-bold text-unmsm-azul">{tipo.plural}</h3>
                        <p class="mt-3 text-sm leading-relaxed text-slate-600">
                            Se miden en {tipo.medidas.join(" y ")}.
                        </p>
                        <p class="mt-auto pt-6 text-sm font-semibold text-unmsm-azul">
                            {tipo.publicados > 0
                                ? `Ver ${tipo.publicados} ${tipo.publicados === 1 ? "programa" : "programas"}`
                                : "Próximamente"}
                            <span aria-hidden="true" class="ml-1 inline-block transition group-hover:translate-x-1">→</span>
                        </p>
                    </a>
                ))
            }
        </div>

        {/* Muestra de la oferta, con filtro. La portada de Blade tiene esto y
            la de Astro no lo tenía: se salía de la portada sin haber visto un
            solo curso. */}
        <div class="mt-20">
            <OfertaDestacada tipos={tipos} programas={programas} />
        </div>    </section>

    {inscripcion && <PasosInscripcion inscripcion={inscripcion} />}

    {/* Banda institucional, como en Blade: da respiro entre bloques y sitúa al
        CERSEU dentro de la Universidad. */}
    <section class="bg-unmsm-azul py-16 text-white">
        <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                    {portada.kicker}
                </p>
                <h2 class="mt-2 font-serif text-2xl font-bold sm:text-3xl">
                    Tradición humanística, vocación de futuro
                </h2>
                <p class="mt-3 max-w-2xl text-slate-200">
                    En la universidad más antigua de América, el CERSEU acerca las letras y
                    las ciencias humanas a toda la comunidad.
                </p>
            </div>
            <a
                href="/nosotros"
                class="inline-block flex-none rounded-lg border border-white/40 px-6 py-3 font-semibold transition hover:bg-white/10"
            >
                Conócenos
            </a>
        </div>
    </section>
</Base>
