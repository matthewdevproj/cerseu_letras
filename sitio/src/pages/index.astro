---
import Base from '../layouts/Base.astro';
import { obtenerTipos, obtenerConfiguracion } from '../lib/api';

// Se resuelve en el build: el HTML sale ya con estos datos dentro y el
// visitante no espera a ninguna petición.
const tipos = await obtenerTipos();

// El hero se edita en Configuración, no aquí. Tener el titular en la
// plantilla obligaría a desplegar para cambiar una palabra.
const { portada } = await obtenerConfiguracion();
const fondo = portada.imagenes[0];
---

<Base
    titulo="Inicio"
    descripcion="Formación abierta a toda la comunidad: talleres, cursos y especializaciones del CERSEU de la Facultad de Letras."
>
    <section class="relative isolate overflow-hidden text-white">
        {
            fondo && (
                <img
                    src={fondo}
                    alt=""
                    fetchpriority="high"
                    decoding="async"
                    class="absolute inset-0 -z-10 h-full w-full object-cover"
                />
            )
        }
        {/* Velo sobre la foto: sin el, el texto blanco pierde contraste sobre las
            zonas claras del campus y deja de cumplir AA. */}
        <div class="absolute inset-0 -z-10 bg-linear-to-r from-unmsm-azul-dark/95 via-unmsm-azul/85 to-unmsm-azul/60"></div>

        <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
            {portada.kicker && (
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                    {portada.kicker}
                </p>
            )}

            {portada.titulo && (
                <h1 class="mt-4 max-w-3xl font-serif text-4xl font-bold leading-tight sm:text-5xl">
                    {portada.titulo}
                </h1>
            )}

            {portada.texto && (
                <p class="mt-5 max-w-2xl text-lg text-slate-100">{portada.texto}</p>
            )}

            {portada.acciones.length > 0 && (
                <div class="mt-8 flex flex-wrap gap-4">
                    {portada.acciones.map((accion, i) => (
                        <a
                            href={accion.url}
                            class={
                                i === 0
                                    ? "rounded-lg bg-unmsm-dorado px-6 py-3 font-semibold text-unmsm-azul-dark transition hover:bg-unmsm-dorado-light"
                                    : "rounded-lg border border-white/40 px-6 py-3 font-semibold transition hover:bg-white/10"
                            }
                        >
                            {accion.texto}
                        </a>
                    ))}
                </div>
            )}
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="font-serif text-2xl font-bold text-unmsm-azul">Nuestra oferta</h2>
        <p class="mt-2 text-slate-600">Cada tipo se mide con la unidad que le es propia.</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-3">
            {
                tipos.map((tipo) => (
                    <a
                        href={`/${tipo.slug}`}
                        class="block rounded-xl border border-slate-200 border-l-4 border-l-unmsm-azul p-6 shadow-sm transition hover:border-unmsm-azul/40 hover:shadow-md"
                    >
                        <h3 class="font-serif text-lg font-bold text-unmsm-azul">{tipo.plural}</h3>
                        <p class="mt-2 text-sm text-slate-600">
                            Se miden en {tipo.medidas.join(' y ')}.
                        </p>
                        <p class="mt-4 text-3xl font-bold text-unmsm-azul">{tipo.publicados}</p>
                        <p class="text-xs uppercase tracking-wider text-slate-500">
                            {tipo.publicados === 1 ? 'programa publicado' : 'programas publicados'}
                        </p>
                    </a>
                ))
            }
        </div>
    </section>
</Base>
