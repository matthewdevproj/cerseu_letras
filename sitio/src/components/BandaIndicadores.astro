---
import type { TipoOferta } from '../lib/api';

interface Props {
    tipos: TipoOferta[];
    docentes: number;
}

const { tipos, docentes } = Astro.props;

// La UNMSM se fundó el 12 de mayo de 1551. Se calcula, no se escribe: un
// número fijo aquí envejece solo cada 12 de mayo.
const hoy = new Date();
const anios = hoy.getFullYear() - 1551 - (hoy < new Date(hoy.getFullYear(), 4, 12) ? 1 : 0);

const birrete =
    'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.499 5.221 69.17 69.17 0 00-2.923.897';
const personas =
    'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z';
const columna =
    'M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v18m3-13.636l10.5-3.819';

const cifras = [
    ...tipos.map((t) => ({
        valor: t.publicados > 0 ? String(t.publicados) : '—',
        etiqueta: t.plural,
        nota: t.publicados === 0 ? 'Próximamente' : null,
        icono: birrete,
        enlace: `/${t.slug}`,
    })),
    { valor: `${docentes}`, etiqueta: 'Docentes', nota: null, icono: personas, enlace: '/plana-docente' },
    { valor: String(anios), etiqueta: 'Años de historia', nota: null, icono: columna, enlace: null },
];
---

{/* Banda oscura pegada al hero, como en Blade: se lee como el pie de la
    portada y no como una sección aparte. */}
<section class="relative isolate bg-unmsm-azul-dark text-white" aria-label="El CERSEU en cifras">
    <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-[0.05]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 30px 30px;"
    >
    </div>

    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-y-6 px-6 py-10 sm:grid-cols-3 lg:grid-cols-5 lg:divide-x lg:divide-white/10">
        {
            cifras.map((cifra) => {
                const Etiqueta = cifra.enlace ? 'a' : 'div';
                return (
                    <Etiqueta
                        href={cifra.enlace ?? undefined}
                        class:list={[
                            'group block px-4 text-center',
                            cifra.enlace ? 'transition hover:text-unmsm-dorado-light' : '',
                        ]}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="mx-auto h-6 w-6 text-unmsm-dorado"
                            aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d={cifra.icono} />
                        </svg>
                        <dd class="mt-2 font-serif text-3xl font-bold">{cifra.valor}</dd>
                        <dt class="mt-1 text-[0.7rem] font-medium uppercase tracking-wider text-slate-300">
                            {cifra.etiqueta}
                        </dt>
                        {cifra.nota && (
                            <p class="mt-0.5 text-[0.65rem] uppercase tracking-wider text-unmsm-dorado/70">
                                {cifra.nota}
                            </p>
                        )}
                    </Etiqueta>
                );
            })
        }
    </dl>
</section>
