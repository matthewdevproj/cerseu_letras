---
import type { TipoOferta } from '../lib/api';

interface Props {
    tipos: TipoOferta[];
    docentes: number;
}

const { tipos, docentes } = Astro.props;

// La UNMSM se fundó el 12 de mayo de 1551. Se calcula, no se escribe: un
// número fijo aquí envejece solo cada 12 de mayo.
const fundacion = new Date(1551, 4, 12);
const hoy = new Date();
let anios = hoy.getFullYear() - fundacion.getFullYear();
if (hoy < new Date(hoy.getFullYear(), 4, 12)) anios -= 1;
---

<section class="border-y border-slate-200 bg-slate-50" aria-label="El CERSEU en cifras">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 divide-slate-200 px-6 py-10 sm:grid-cols-3 sm:divide-x lg:grid-cols-5">
        {
            tipos.map((tipo) => (
                <div class="px-4 py-3 text-center">
                    {/* Un «0» en grande anuncia un vacío. Mientras esa sección no
                        tenga oferta, se dice «Próximamente», que informa lo mismo
                        sin parecer un error. */}
                    <dd class="font-serif text-3xl font-bold text-unmsm-azul">
                        {tipo.publicados > 0 ? tipo.publicados : '—'}
                    </dd>
                    <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-500">
                        {tipo.plural}
                    </dt>
                    {tipo.publicados === 0 && (
                        <p class="mt-0.5 text-[0.65rem] uppercase tracking-wider text-slate-400">
                            Próximamente
                        </p>
                    )}
                </div>
            ))
        }

        <div class="px-4 py-3 text-center">
            <dd class="font-serif text-3xl font-bold text-unmsm-azul">{docentes}</dd>
            <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-500">Docentes</dt>
        </div>

        <div class="col-span-2 px-4 py-3 text-center sm:col-span-1">
            <dd class="font-serif text-3xl font-bold text-unmsm-azul">{anios}</dd>
            <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-500">
                Años de historia
            </dt>
        </div>
    </dl>
</section>
