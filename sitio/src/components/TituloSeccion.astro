---
interface Props {
    titulo: string;
    bajada?: string;
    /** Centrado como en la portada, o alineado a la izquierda en interiores. */
    centrado?: boolean;
    /** Texto pequeño en versalitas doradas sobre el título. */
    kicker?: string;
    claro?: boolean;
}

const { titulo, bajada, centrado = false, kicker, claro = false } = Astro.props;
---

<header class={centrado ? 'text-center' : ''}>
    {
        kicker && (
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                {kicker}
            </p>
        )
    }

    <h2
        class:list={[
            'font-serif text-3xl font-bold tracking-tight',
            kicker ? 'mt-2' : '',
            claro ? 'text-white' : 'text-unmsm-azul',
        ]}
    >
        {titulo}
    </h2>

    {/* La regla dorada bajo el título es el gesto que identifica al sitio en
        Blade. Se conserva aquí para que las dos versiones se reconozcan. */}
    <div
        class:list={[
            'mt-3 h-1 w-16 rounded-full bg-unmsm-dorado',
            centrado ? 'mx-auto' : '',
        ]}
        aria-hidden="true"
    >
    </div>

    {
        bajada && (
            <p
                class:list={[
                    'mt-4 max-w-2xl text-lg',
                    centrado ? 'mx-auto' : '',
                    claro ? 'text-slate-200' : 'text-slate-600',
                ]}
            >
                {bajada}
            </p>
        )
    }
</header>
