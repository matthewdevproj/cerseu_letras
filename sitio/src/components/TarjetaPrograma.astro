---
import type { Programa } from '../lib/api';

interface Props {
    programa: Programa;
}

const { programa } = Astro.props;

// La ruta se compone aquí, no viene de la API: el backend entrega identidad
// (tipo + slug) y cada frontend decide su estructura de enlaces.
const ruta = `/${programa.tipo}/${programa.slug}`;
---

<article
    class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-unmsm-azul/30 hover:shadow-xl"
>
    <div class="relative aspect-16/10 overflow-hidden bg-slate-100">
        {
            programa.imagen && (
                <img
                    src={programa.imagen}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
            )
        }

        {/* Velo inferior: los distintivos van sobre la foto, como en Blade, y
            sin él pierden legibilidad cuando la imagen es clara justo ahí. */}
        <div
            aria-hidden="true"
            class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-black/70 to-transparent"
        >
        </div>

        {
            programa.tipo_label && (
                <span class="absolute left-3 top-3 rounded-md bg-unmsm-azul px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
                    {programa.tipo_label}
                </span>
            )
        }

        {
            programa.estado === 'proximamente' && (
                <span class="absolute right-3 top-3 rounded-md bg-unmsm-dorado px-2.5 py-1 text-xs font-semibold text-unmsm-azul-dark shadow-sm">
                    Próximamente
                </span>
            )
        }

        <div class="absolute inset-x-3 bottom-3 flex flex-wrap gap-2">
            {
                programa.medidas.map((medida) => (
                    <span class="rounded-full bg-unmsm-dorado/95 px-2.5 py-1 text-xs font-semibold text-unmsm-azul-dark">
                        {medida}
                    </span>
                ))
            }
            {
                programa.modalidad && (
                    <span class="rounded-full bg-white/95 px-2.5 py-1 text-xs font-semibold text-slate-700">
                        {programa.modalidad}
                    </span>
                )
            }
        </div>
    </div>

    <div class="flex flex-1 flex-col p-6">
        <h3 class="font-serif text-lg font-bold leading-snug text-unmsm-azul">
            {/* El enlace cubre la tarjeta entera, pero el texto accesible sigue
                siendo solo el título: un area de clic grande no tiene por qué
                convertirse en un nombre de enlace largo. */}
            <a href={ruta} class="after:absolute after:inset-0 hover:underline">
                {programa.nombre}
            </a>
        </h3>

        {programa.sumilla && <p class="mt-3 line-clamp-3 text-sm text-slate-600">{programa.sumilla}</p>}

        <span
            aria-hidden="true"
            class="mt-auto block rounded-lg border-2 border-unmsm-azul/20 px-4 py-2.5 pt-2.5 text-center text-sm font-semibold text-unmsm-azul transition group-hover:border-unmsm-azul group-hover:bg-unmsm-azul group-hover:text-white"
            style="margin-top:auto"
        >
            Más información
        </span>
    </div>
</article>

<style>
    article {
        position: relative;
    }
</style>
