---
import type { Programa } from '../lib/api';

interface Props {
    programa: Programa;
}

const { programa } = Astro.props;

// La ruta se compone aquí, no viene de la API: el backend entrega identidad
// (tipo + slug) y cada frontend decide su estructura de enlaces.
const ruta = `/${programa.tipo}/${programa.slug}`;
---

<article
    class="flex flex-col overflow-hidden rounded-xl border border-slate-200 shadow-sm transition hover:border-unmsm-azul/40 hover:shadow-md"
>
    {
        programa.imagen && (
            <a href={ruta} class="block" tabindex="-1" aria-hidden="true">
                <img
                    src={programa.imagen}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-44 w-full object-cover"
                />
            </a>
        )
    }

    <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap gap-2">
        {
            programa.medidas.map((medida) => (
                <span class="rounded-full bg-unmsm-dorado/15 px-3 py-1 text-xs font-medium text-unmsm-azul-dark">
                    {medida}
                </span>
            ))
        }
        {
            programa.modalidad && (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                    {programa.modalidad}
                </span>
            )
        }
        {
            programa.estado === 'proximamente' && (
                <span class="rounded-full bg-unmsm-azul/10 px-3 py-1 text-xs font-medium text-unmsm-azul">
                    Próximamente
                </span>
            )
        }
    </div>

    <h2 class="mt-4 font-serif text-lg font-bold leading-snug text-unmsm-azul">
        <a href={ruta} class="hover:underline">{programa.nombre}</a>
    </h2>

    {programa.sumilla && <p class="mt-3 line-clamp-3 text-sm text-slate-600">{programa.sumilla}</p>}

    <a href={ruta} class="mt-auto pt-5 text-sm font-semibold text-unmsm-azul hover:underline">
        Más información <span aria-hidden="true">→</span>
        <span class="sr-only">sobre {programa.nombre}</span>
    </a>
    </div>
</article>
