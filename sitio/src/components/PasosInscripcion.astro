---
import TituloSeccion from './TituloSeccion.astro';
import type { ConfiguracionSitio } from '../lib/api';
import Boton from './Boton.astro';
import { faArrowRight } from '@fortawesome/free-solid-svg-icons';

interface Props {
    inscripcion: NonNullable<ConfiguracionSitio['inscripcion']>;
}

const { inscripcion } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-unmsm-azul-dark py-20 text-white">
    {/* Textura de puntos: el mismo recurso que usa la banda equivalente en
        Blade, para que las dos versiones se reconozcan. */}
    <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 34px 34px;"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute -top-40 left-1/2 -z-10 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-unmsm-azul/40 blur-3xl"
    >
    </div>

    <div class="mx-auto max-w-6xl px-6">
        <TituloSeccion
            titulo={inscripcion.titulo ?? 'Cómo inscribirte'}
            kicker={inscripcion.eyebrow ?? undefined}
            centrado
            claro
        />

        {/* Línea de tiempo: la misma que conecta los pasos en Blade. Solo en
            escritorio, donde las tarjetas van en fila; apiladas no significa
            nada. */}
        <div class="relative mt-12">
            <div
                aria-hidden="true"
                class="absolute left-[12.5%] right-[12.5%] top-6 hidden h-px bg-linear-to-r from-unmsm-dorado/10 via-unmsm-dorado to-unmsm-dorado/10 lg:block"
            >
            </div>

        <ol class="relative grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                inscripcion.pasos.map((paso, i) => (
                    <li
                        class:list={[
                            'relative rounded-xl border-b-4 p-6 transition',
                            paso.destacado
                                ? 'border-unmsm-azul bg-white text-slate-800 shadow-xl'
                                : 'border-unmsm-dorado bg-white/[0.06] ring-1 ring-white/10 hover:bg-white/[0.1]',
                        ]}
                    >
                        <div
                            class:list={[
                                'flex h-12 w-12 items-center justify-center rounded-full',
                                paso.destacado
                                    ? 'bg-unmsm-azul text-white'
                                    : 'bg-unmsm-dorado/20 text-unmsm-dorado-light ring-1 ring-unmsm-dorado/30',
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-6 w-6"
                                aria-hidden="true"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d={paso.icono_path} />
                            </svg>
                        </div>

                        <p class="mt-4 text-xs font-semibold uppercase tracking-wider opacity-60">
                            Paso {i + 1}
                        </p>
                        <h3 class="mt-1 font-serif text-lg font-bold leading-snug">{paso.titulo}</h3>

                        {paso.fecha && (
                            <p
                                class:list={[
                                    'mt-2 text-sm font-bold',
                                    paso.destacado ? 'text-unmsm-azul' : 'text-unmsm-dorado-light',
                                ]}
                            >
                                {paso.fecha}
                            </p>
                        )}

                        {paso.detalle && (
                            <p
                                class:list={[
                                    'mt-2 text-sm leading-relaxed',
                                    paso.destacado ? 'text-slate-600' : 'text-slate-300',
                                ]}
                            >
                                {paso.detalle}
                            </p>
                        )}

                        {paso.publico && (
                            <p class="mt-2 text-xs font-medium opacity-70">· {paso.publico}</p>
                        )}
                    </li>
                ))
            }
        </ol>
        </div>

        {
            inscripcion.boton && (
                <div class="mt-12 text-center">
                    <Boton href={inscripcion.boton.url} tamano="grande" icono={faArrowRight} iconoAlFinal>
                        {inscripcion.boton.texto}
                    </Boton>
                </div>
            )
        }
    </div>
</section>
