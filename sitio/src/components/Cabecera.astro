---
import BarraSuperior from './BarraSuperior.astro';
import Buscador from './Buscador.astro';
import Icono from './Icono.astro';
import { faMagnifyingGlass, faXmark, faBars } from '@fortawesome/free-solid-svg-icons';
import type { ConfiguracionSitio, ItemMenu } from '../lib/api';

interface Props {
    sitio: ConfiguracionSitio;
    menu: ItemMenu[];
    /**
     * La página abre con una imagen a sangre y la cabecera se monta encima,
     * como en la portada. Sin esto la cabecera es una banda azul sólida, que es
     * lo que necesitan las páginas que no empiezan con un hero.
     */
    sobreHero?: boolean;
}

const { sitio, menu, sobreHero = false } = Astro.props;
---

{/* `sticky` en las páginas normales y superpuesta en las que abren con imagen.
    El comportamiento al bajar es el mismo en las dos: la barra de contacto se
    pliega y la navegación pasa a blanco, para que sobre el contenido claro los
    enlaces se sigan leyendo. */}
<header
    class:list={[
        'cabecera z-50',
        // `fixed` y no `absolute`: superpuesta al hero tiene que seguir ahi al
        // bajar —para eso cambia a blanco—, y en absolute se iba con el scroll
        // y dejaba la pagina sin navegacion.
        sobreHero ? 'fixed inset-x-0 top-0' : 'sticky top-0 bg-unmsm-azul',
    ]}
    data-sobre-hero={sobreHero ? '1' : undefined}
>
    <BarraSuperior sitio={sitio} />

    <div
        id="barra-navegacion"
        class:list={[
            'relative transition-[background-color,box-shadow,padding] duration-300',
            // El desenfoque va como utilidad y no escrito a mano en el CSS de
            // abajo: alli el minificador dejaba solo `-webkit-backdrop-filter`
            // y Firefox se quedaba con la barra translucida y sin desenfoque,
            // con el texto de la navegacion sobre el contenido en movimiento.
            // La utilidad de Tailwind emite las dos formas.
            '[.bajada_&]:backdrop-blur-lg [.bajada_&]:backdrop-saturate-150',
            sobreHero ? 'bg-transparent' : 'bg-unmsm-azul',
        ]}
    >
        <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 lg:px-8">
            <a href="/" class="flex-none" aria-label={`${sitio.nombre} — ir al inicio`}>
                {
                    sitio.logo ? (
                        /* El logotipo es azul oscuro sobre transparente, así que
                           sobre la cabecera oscura se fuerza a blanco con un
                           filtro. Se hace igual en Blade, y funciona con
                           cualquier logo que suba la Unidad sin exigirle una
                           variante en blanco. */
                        <img
                            id="logo-cabecera"
                            src={sitio.logo}
                            alt={sitio.nombre ?? 'CERSEU'}
                            width="1234"
                            height="310"
                            class="h-11 w-auto brightness-0 invert transition sm:h-14"
                        />
                    ) : (
                        <span class="block font-serif text-xl font-bold leading-tight text-white">
                            {sitio.nombre}
                        </span>
                    )
                }
            </a>

            <nav
                class="ml-auto hidden items-center gap-x-6 text-sm font-medium lg:flex"
                aria-label="Principal"
            >
                {
                    menu.map((item) =>
                        item.hijos.length > 0 ? (
                            /* Abre al pasar el ratón —donde hay ratón— y no se
                               queda abierto al irse, que es lo que hacía el
                               <details> anterior. Con teclado funciona igual sin
                               depender del ratón: Enter o flecha abajo abren,
                               Escape cierra devolviendo el foco, y salir con el
                               tabulador cierra solo. */
                            <div
                                x-data="desplegable"
                                x-on:mouseenter="entra()"
                                x-on:mouseleave="sale()"
                                x-on:focusout="alSalirElFoco()"
                                x-on:keydown.escape.prevent="cerrar(true)"
                                class="relative"
                            >
                                <button
                                    type="button"
                                    x-ref="boton"
                                    x-on:click="alternar()"
                                    x-on:keydown.arrow-down.prevent="abierto = true"
                                    x-bind:aria-expanded="abierto ? 'true' : 'false'"
                                    class="nav-item flex cursor-pointer items-center gap-1 text-white transition hover:text-unmsm-dorado-light"
                                >
                                    {item.etiqueta}
                                    <span
                                        aria-hidden="true"
                                        x-bind:class="abierto ? 'rotate-180' : ''"
                                        class="inline-block text-[0.7em] transition-transform duration-200"
                                    >
                                        ▾
                                    </span>
                                </button>

                                {/* Puente invisible hasta el panel: sin él, el
                                    hueco de 12 px entre el botón y la lista
                                    dispara `mouseleave` al bajar el ratón y el
                                    menú se cierra justo cuando ibas a usarlo. */}
                                <div
                                    x-show="abierto"
                                    x-cloak
                                    aria-hidden="true"
                                    class="absolute left-0 top-full h-3 w-full"
                                />

                                <ul
                                    x-show="abierto"
                                    x-cloak
                                    x-transition:enter="transition duration-150 ease-out"
                                    x-transition:enter-start="opacity-0 -translate-y-1"
                                    x-transition:enter-end="opacity-100 translate-y-0"
                                    x-transition:leave="transition duration-100 ease-in"
                                    x-transition:leave-start="opacity-100"
                                    x-transition:leave-end="opacity-0"
                                    class="absolute left-0 top-full z-20 mt-3 min-w-56 overflow-hidden rounded-xl bg-white py-2 text-slate-700 shadow-2xl ring-1 ring-black/5"
                                >
                                    {/* Filo dorado arriba: el mismo gesto de marca
                                        que separa las secciones. */}
                                    <span
                                        aria-hidden="true"
                                        class="marca-degradado absolute inset-x-0 top-0 h-0.5"
                                    />

                                    {item.hijos.map((hijo) => (
                                        <li>
                                            <a
                                                href={hijo.enlace ?? '#'}
                                                target={hijo.nueva_pestana ? '_blank' : undefined}
                                                rel={hijo.nueva_pestana ? 'noopener noreferrer' : undefined}
                                                x-on:click="cerrar()"
                                                class="block border-l-2 border-transparent px-4 py-2 text-sm transition hover:border-unmsm-dorado hover:bg-slate-50 hover:text-unmsm-azul"
                                            >
                                                {hijo.etiqueta}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ) : (
                            <a
                                href={item.enlace ?? '#'}
                                target={item.nueva_pestana ? '_blank' : undefined}
                                rel={item.nueva_pestana ? 'noopener noreferrer' : undefined}
                                class="nav-item text-white transition hover:text-unmsm-dorado-light"
                            >
                                {item.etiqueta}
                            </a>
                        )
                    )
                }
            </nav>

            <div class="ml-auto flex items-center gap-2 lg:ml-6">
                <span aria-hidden="true" class="hidden h-6 w-px bg-white/25 lg:block"></span>

                {/* La lupa abre el campo, como en el sitio anterior: una caja de
                    búsqueda permanente le roba sitio al menú y al logotipo. */}
                <button
                    type="button"
                    id="abrir-buscador"
                    class="nav-item rounded-md p-2 text-white transition hover:text-unmsm-dorado-light"
                    aria-expanded="false"
                    aria-controls="caja-buscador"
                >
                    <Icono icono={faMagnifyingGlass} clase="h-5 w-5" etiqueta="Buscar en el sitio" />
                </button>

                <button
                    type="button"
                    id="abrir-menu"
                    class="nav-item rounded-md p-2 text-white transition hover:text-unmsm-dorado-light lg:hidden"
                    aria-expanded="false"
                    aria-controls="menu-movil"
                >
                    <Icono icono={faBars} clase="h-5 w-5" etiqueta="Abrir el menú" />
                </button>
            </div>
        </div>

        {/* Fuera de la fila: al desplegarse ocupa el ancho completo y no
            desplaza ni el logotipo ni el menú. */}
        <div id="caja-buscador" class="hidden border-t border-white/10">
            <div class="mx-auto max-w-7xl px-4 py-3 lg:px-8">
                <Buscador />
            </div>
        </div>
    </div>

    {/* Menú en pantalla estrecha. Panel aparte y no el mismo marcado escondido:
        el desplegable de escritorio se abre hacia abajo sobre el contenido, y
        aquí tiene que empujar y poder recorrerse con el dedo. */}
    <div id="menu-movil" class="hidden border-t border-white/10 bg-unmsm-azul lg:hidden">
        <nav class="mx-auto max-w-7xl px-4 py-4" aria-label="Principal (móvil)">
            <ul class="space-y-1">
                {
                    menu.map((item) => (
                        <li>
                            {item.hijos.length > 0 ? (
                                <details class="group">
                                    <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-sm font-medium text-white transition hover:bg-white/10 [&::-webkit-details-marker]:hidden">
                                        {item.etiqueta}
                                        <span
                                            aria-hidden="true"
                                            class="text-xs transition group-open:rotate-180"
                                        >
                                            ▾
                                        </span>
                                    </summary>
                                    <ul class="mb-1 ml-3 border-l border-white/15 pl-3">
                                        {item.hijos.map((hijo) => (
                                            <li>
                                                <a
                                                    href={hijo.enlace ?? '#'}
                                                    target={hijo.nueva_pestana ? '_blank' : undefined}
                                                    rel={hijo.nueva_pestana ? 'noopener noreferrer' : undefined}
                                                    class="block rounded-md px-3 py-2 text-sm text-white/80 transition hover:bg-white/10 hover:text-white"
                                                >
                                                    {hijo.etiqueta}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </details>
                            ) : (
                                <a
                                    href={item.enlace ?? '#'}
                                    target={item.nueva_pestana ? '_blank' : undefined}
                                    rel={item.nueva_pestana ? 'noopener noreferrer' : undefined}
                                    class="block rounded-md px-3 py-2.5 text-sm font-medium text-white transition hover:bg-white/10"
                                >
                                    {item.etiqueta}
                                </a>
                            )}
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style is:global>
    /* Al bajar, la navegación pasa a blanco y lo que iba en blanco tiene que
       oscurecerse o desaparece. Se hace con una clase en el contenedor y no
       tocando cada elemento desde JavaScript: así el estado vive en un solo
       sitio y las transiciones las resuelve el CSS. */
    .cabecera.bajada #barra-superior {
        height: 0;
        opacity: 0;
    }

    /*
     * Cristal al bajar. La opacidad estaba en 0.95, que es casi opaco: el
     * `backdrop-filter` estaba puesto pero no se veía, porque no quedaba fondo
     * que desenfocar. A 0.72 el desenfoque se lee y el contenido sigue pasando
     * la barra sin competir con el texto de la navegación.
     */
    .cabecera.bajada #barra-navegacion {
        background-color: rgb(255 255 255 / 0.72);
        box-shadow:
            0 1px 0 0 rgb(15 43 72 / 0.06),
            0 10px 30px -12px rgb(15 43 72 / 0.25);
    }

    /* Donde no hay `backdrop-filter` el fondo translúcido dejaría el texto
       ilegible sobre el contenido que pasa por detrás: allí se vuelve opaco.
       Se comprueba solo la forma sin prefijo porque es la única que emite la
       utilidad de Tailwind — así el Safari antiguo, que únicamente entiende
       `-webkit-`, cae al fondo opaco en vez de quedarse sin desenfoque. */
    @supports not (backdrop-filter: blur(1px)) {
        .cabecera.bajada #barra-navegacion {
            background-color: rgb(255 255 255 / 0.97);
        }
    }

    /* Filo de marca bajo la barra al bajar: cierra el cristal con el mismo
       gesto —azul a dorado— que separa las secciones. */
    .cabecera.bajada #barra-navegacion::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 1px;
        background: var(--degradado-marca);
        opacity: 0.6;
    }

    .cabecera.bajada .nav-item,
    .cabecera.bajada .nav-item:hover {
        color: var(--color-unmsm-azul);
    }

    .cabecera.bajada #logo-cabecera {
        filter: none;
    }

    .cabecera.bajada #caja-buscador,
    .cabecera.bajada #menu-movil {
        border-color: rgb(0 0 0 / 0.08);
    }

    .cabecera.bajada #menu-movil {
        background-color: #fff;
    }

    .cabecera.bajada #menu-movil a,
    .cabecera.bajada #menu-movil summary {
        color: var(--color-unmsm-azul);
    }

    /* El campo de búsqueda es blanco sobre azul; sobre la barra clara necesita
       lo contrario o el texto no se lee. */
    .cabecera.bajada #buscador-q {
        background-color: #fff;
        border-color: rgb(148 163 184);
        color: rgb(30 41 59);
    }

    .cabecera.bajada #buscador-q::placeholder {
        color: rgb(100 116 139);
    }

    @media (prefers-reduced-motion: reduce) {
        .cabecera *,
        .cabecera {
            transition: none !important;
        }
    }
</style>

<script is:inline>
    (function () {
        function iniciar() {
            var cabecera = document.querySelector('.cabecera');
            // Con las transiciones de vista el script vuelve a ejecutarse y el
            // oyente de `astro:page-load` tambien dispara: sin esta marca cada
            // navegacion anadiria un juego mas de oyentes sobre los mismos
            // botones, y el buscador se abriria y cerraria a la vez.
            if (!cabecera || cabecera.dataset.listo === '1') return;
            cabecera.dataset.listo = '1';

            var caja = document.getElementById('caja-buscador');
            var abrirBuscador = document.getElementById('abrir-buscador');
            var menu = document.getElementById('menu-movil');
            var abrirMenu = document.getElementById('abrir-menu');

            function alternar(panel, boton) {
                if (!panel || !boton) return;
                var abierto = !panel.classList.contains('hidden');
                panel.classList.toggle('hidden', abierto);
                boton.setAttribute('aria-expanded', String(!abierto));
                return !abierto;
            }

            abrirBuscador &&
                abrirBuscador.addEventListener('click', function () {
                    var abierto = alternar(caja, abrirBuscador);
                    if (abierto) {
                        var campo = document.getElementById('buscador-q');
                        campo && campo.focus();
                    }
                });

            abrirMenu &&
                abrirMenu.addEventListener('click', function () {
                    alternar(menu, abrirMenu);
                });

            // Escape cierra lo que esté abierto, empezando por el buscador.
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                if (caja && !caja.classList.contains('hidden')) {
                    // Solo si el desplegable de sugerencias ya está cerrado: la
                    // primera pulsación la usa el propio buscador.
                    var campo = document.getElementById('buscador-q');
                    if (campo && campo.getAttribute('aria-expanded') === 'true') return;
                    alternar(caja, abrirBuscador);
                    abrirBuscador && abrirBuscador.focus();
                } else if (menu && !menu.classList.contains('hidden')) {
                    alternar(menu, abrirMenu);
                    abrirMenu && abrirMenu.focus();
                }
            });

            // Estado según el desplazamiento. `requestAnimationFrame` para no
            // hacer trabajo en cada evento de scroll.
            var bajada = false;
            var pendiente = false;

            function revisar() {
                var ahora = window.scrollY > 50;
                if (ahora !== bajada) {
                    bajada = ahora;
                    cabecera.classList.toggle('bajada', bajada);
                }
                pendiente = false;
            }

            revisar();
            window.addEventListener(
                'scroll',
                function () {
                    if (pendiente) return;
                    pendiente = true;
                    window.requestAnimationFrame(revisar);
                },
                { passive: true }
            );
        }

        iniciar();
        document.addEventListener('astro:page-load', iniciar);
    })();
</script>
