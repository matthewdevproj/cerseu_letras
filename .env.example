# Variables que consume docker-compose.yml.
#
# Compose sustituye ${VARIABLE} leyendo el fichero .env que esté JUNTO al
# docker-compose.yml, es decir en la raíz del repositorio. NO lee el .env de
# cerseuletras/, que es el de Laravel. Son dos ficheros distintos con dos
# lectores distintos, y confundirlos deja MySQL con las contraseñas de
# plantilla mientras la aplicación intenta entrar con las que tú pusiste.
#
#   cp .env.example .env
#
# Las tres contraseñas de aquí deben coincidir con las de cerseuletras/.env:
#   DB_DATABASE  ↔  DB_DATABASE
#   DB_USERNAME  ↔  DB_USERNAME
#   DB_PASSWORD  ↔  DB_PASSWORD

# Base de datos que crea el contenedor de MySQL al arrancar por primera vez.
DB_DATABASE=cerseuletras
DB_USERNAME=cerseu_user

# Cámbialas. Las de abajo son de plantilla y no valen para nada expuesto.
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_password_de_root

# Puerto por el que se llega a MySQL desde el host (dentro de la red de Docker
# siempre es el 3306). Cámbialo si ya tienes algo escuchando en el 3307.
DB_PORT=3307

# Usuario con el que corre el contenedor de PHP. En Linux debe coincidir con
# el duenio de los ficheros del repositorio o la aplicacion no podra escribir
# en storage/:  id -u  e  id -g  te los dicen. En Windows y macOS da igual.
UID=1000
GID=1000

# Dominios que atiende nginx, separados por espacios. Se inyectan en la
# plantilla de configuracion, asi que levantar el sistema en otro dominio no
# exige tocar ningun .conf. Deja fuera www. si no tienes ese registro DNS.
NGINX_SERVER_NAMES=cerseuletras.unmsm.edu.pe www.cerseuletras.unmsm.edu.pe

# Secreto compartido entre Laravel y el servicio que reconstruye el sitio.
# Un endpoint que lanza un build sin autenticar es una forma comoda de tumbar
# el servidor desde fuera. Cambialo.
CERSEU_BUILD_TOKEN=cambia-este-token
